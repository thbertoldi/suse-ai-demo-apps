{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "additionalRagServices": {
      "type": "object",
      "propertyNames": {
        "pattern": "^rag-[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "productTraffic": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "scenarios": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "vllm",
              "litellm-vllm",
              "qdrant",
              "opensearch",
              "mlflow",
              "mcpo"
            ]
          }
        },
        "maxRounds": {
          "type": "integer",
          "minimum": 0
        },
        "intervalSeconds": {
          "type": "number",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "training": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "suspend": {
          "type": "boolean"
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
